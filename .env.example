# Copie para .env e preencha. O .env real nunca vai para o git.

# Kaggle: lido por scripts_ml/01_baixar.py (token em kaggle.com/settings; aceite os termos do dataset no site)
API_TOKEN_KAGGLE=

# Postgres: o docker compose lê estas variáveis ao subir o banco.
# Os scripts de scripts_ml/ usam os mesmos nomes via ambiente (o default é igual ao daqui).
POSTGRES_USER=ingredientes
POSTGRES_PASSWORD=ingredientes
POSTGRES_DB=ingredientes
POSTGRES_PORT=5432

# Opcionais (o backend tem default): descomente para mudar.
# DATABASE_URL=postgresql://ingredientes:ingredientes@localhost:5432/ingredientes
# CORS_ORIGINS=http://localhost:5199
# VITE_API_URL=http://localhost:8765
